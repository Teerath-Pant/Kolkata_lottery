# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lucky_draw
# Server
PORT=4000
NODE_ENV=development
# In production the server refuses to start with these placeholders: use 2 different random strings of 32+ chars,
# e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-32chars-min
JWT_REFRESH_SECRET=change-me-refresh-secret-32chars-min
ACCESS_TTL=15m
REFRESH_TTL=30d
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# How many reverse proxies (nginx, a load balancer...) sit in front of the server. 0 = none (X-Forwarded-For ignored).
# Set it to the real number when deployed behind proxies, otherwise every player shares the proxy's IP in rate limits.
TRUST_PROXY=0
# Lock a user ID for LOGIN_LOCK_MINUTES after this many wrong passwords
LOGIN_MAX_FAILURES=10
LOGIN_LOCK_MINUTES=15
# Signup OTP. console = prints the code in the server log and returns it to the app (dev only; the server refuses it in production).
# webhook = POSTs {"to": "9876543210", "message": "..."} as JSON (+ "Authorization: Bearer SMS_WEBHOOK_TOKEN") to your SMS gateway / relay.
SMS_PROVIDER=console
# SMS_WEBHOOK_URL=https://sms.example.com/send
# SMS_WEBHOOK_TOKEN=
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
# Largest single admin coin adjustment; wallets can never exceed 1,000,000,000,000 coins
ADMIN_MAX_ADJUST=1000000
# GET /packages is served from memory for this long (0 = always fresh)
PACKAGES_CACHE_MS=2000
RUN_CRON=true
# Game config
SIGNUP_BONUS=500
BUY_CUTOFF_SECONDS=30
# Seed admin
ADMIN_USERNAME=admin
# In production ADMIN_PASSWORD is required (12+ chars, not this dev default)
ADMIN_PASSWORD=Admin@12345
BCRYPT_ROUNDS=12
